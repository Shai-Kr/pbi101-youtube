table Products
	lineageTag: 8caab66d-00b0-5eb3-96ad-4b03ee69f4e5

	column ProductID
		dataType: int64
		isKey
		formatString: 0
		lineageTag: 7fbb3d9f-5094-5145-95bd-da51282f34da
		summarizeBy: none
		sourceColumn: ProductID

	column Product
		dataType: string
		lineageTag: af0dc52e-1327-56fd-bb08-11e3fe6519f5
		summarizeBy: none
		sourceColumn: Product

	column Category
		dataType: string
		lineageTag: a841e047-30dc-56d1-9e15-27043dd2ca52
		summarizeBy: none
		sourceColumn: Category

	column 'List Price'
		dataType: double
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 226a9d34-6f87-56ff-b493-b1cf1da77758
		summarizeBy: none
		sourceColumn: List Price

	partition Products = m
		mode: import
		source =
				let
					Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/Shai-Kr/pbi101-youtube/main/videos/03-ai-skills-intro/data/products.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"ProductID", Int64.Type}, {"Product", type text}, {"Category", type text}, {"List Price", type number}}, "en-US")
				in
					Typed


					Typed = Table.TransformColumnTypes(Headers, {{"Date", type date}, {"Year", Int64.Type}, {"Month", type date}, {"Month Name", type text}, {"Month No", Int64.Type}, {"Weekday", type text}, {"Weekday No", Int64.Type}}, "en-US")

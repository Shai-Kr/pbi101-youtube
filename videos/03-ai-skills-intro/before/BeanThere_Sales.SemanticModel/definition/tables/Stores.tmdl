table Stores
	lineageTag: af72fecf-df7b-5472-93b9-b084d99cbedf

	column StoreID
		dataType: int64
		isKey
		formatString: 0
		lineageTag: 31c29d7d-f428-5ff9-ba9a-8d7b56b1a611
		summarizeBy: none
		sourceColumn: StoreID

	column 'Store Name'
		dataType: string

        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How it works",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1.  ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#0F172A"
                    }
                  },
                  {
                    "value": "'Metric Picker'",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#7C3AED",
                      "fontFamily": "Consolas"
                    }
                  },
                  {
                    "value": " is a field parameter. Each metric row has an ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#0F172A"
                    }
                  },
                  {
                    "value": "Is Sensitive",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#7C3AED",
                      "fontFamily": "Consolas"
                    }
                  },
                  {
                    "value": " flag.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2.  The Sales Team role filters it:  ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#0F172A"
                    }
                  },
                  {
                    "value": "'Metric Picker'[Is Sensitive] = FALSE()",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#7C3AED",
                      "fontFamily": "Consolas"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3.  So a restricted viewer never even gets the sensitive metrics to pick. No error, no broken visual.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4.  The RLS filter and the OLS rules live in the same role.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#0F172A"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]

	column Weekday = FORMAT ( DATE ( 2020, 1, 5 + 'Date'[Day of Week Number] ), "dddd" )
		dataType: string
		lineageTag: d8f95c30-317a-53fb-bb9e-66dfbc2b281c
		summarizeBy: none
		sortByColumn: 'Day of Week Number'

	partition Date = calculated
		mode: import
		source = ```
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2025, 1, 1 ), DATE ( 2026, 10, 31 ) ),
				    "Year Month", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				    "Year", YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Day of Week Number", WEEKDAY ( [Date], 2 )
				)
				```


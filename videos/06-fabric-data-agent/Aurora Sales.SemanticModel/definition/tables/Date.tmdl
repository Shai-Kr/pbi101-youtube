/// Calendar dates, one row per day from January 1, 2025 to October 31, 2026 (the last day with sales).
table Date
	dataCategory: Time

	/// Calendar date.
	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		summarizeBy: none
		sourceColumn: Date

	/// Calendar year, for example 2026.
	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	/// Calendar quarter: Q1, Q2, Q3 or Q4.
	column Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: Quarter

	/// First day of the month, for monthly trends.
	column Month
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: Month

	/// Month number, 1 for January to 12 for December.
	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Month Number

	/// Month name, January to December.
	column 'Month Name'
		dataType: string
		sortByColumn: 'Month Number'
		summarizeBy: none
		sourceColumn: Month Name

	partition Date = m
		mode: import
		source =
				let
					Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com", [RelativePath = DataRoot & "/date.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Headers, {{"Date", type date}, {"Month", type date}, {"Year", Int64.Type}}, "en-US"),
					Quarter = Table.AddColumn(Typed, "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
					MonthNo = Table.AddColumn(Quarter, "Month Number", each Date.Month([Date]), Int64.Type),
					MonthName = Table.AddColumn(MonthNo, "Month Name", each Date.ToText([Date], [Format = "MMMM", Culture = "en-US"]), type text)
				in
					MonthName